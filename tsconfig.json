{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared": ["./shared/index.ts"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared", "worker", "server.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "study", "products"]
}
