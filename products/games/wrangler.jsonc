{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4tm-games",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_URL": "https://games.4tm.io.vn"
  }
}
