{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-learning-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "storage"
    }
  ],
  "vars": {
    "VITE_SUPABASE_URL": "",
    "VITE_SUPABASE_ANON_KEY": "",
    "VITE_CLOUDFLARE_R2_PUBLIC_URL": "",
    "CLOUDFLARE_R2_BUCKET_NAME": "storage",
    "APP_URL": ""
  }
}
