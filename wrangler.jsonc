{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4tm-ecosystem",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "4tm"
    }
  ],
  "vars": {
    "APP_URL": "https://4tm.io.vn",
    "SUPABASE_URL": "https://kxiqjgnhwxzrsrythher.supabase.co"
  }
}
